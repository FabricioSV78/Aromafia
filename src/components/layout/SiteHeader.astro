---
import { contact } from '../../config/contact';
import { site } from '../../config/site';
import Container from '../ui/Container.astro';
import './site-chrome.css';

const socials = [
  { ...contact.instagram, icon: 'instagram' },
  { ...contact.facebook, icon: 'facebook' },
  { ...contact.tiktok, icon: 'tiktok' },
] as const;
---

<header class="site-header">
  <Container class="site-header__inner">
    <a class="site-header__wordmark" href="/" aria-label="AROMAFIA, inicio" translate="no">
      {site.name}
    </a>
    <nav
      class="site-header__navigation site-header__navigation--social"
      aria-label="Redes sociales"
    >
      {socials.map((channel) => (
        <a href={channel.href} rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            {channel.icon === 'instagram' ? (
              <g fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.4" cy="6.6" r="0.8" fill="currentColor" stroke="none" />
              </g>
            ) : (
              <path
                fill="currentColor"
                d={
                  channel.icon === 'facebook'
                    ? 'M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V3.9a26 26 0 0 0-2.6-.1c-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.7v8Z'
                    : 'M16.7 3c.4 2.2 1.6 3.6 3.8 3.8v3.1a8.1 8.1 0 0 1-3.8-1.1v6.3a6 6 0 1 1-5.1-5.9v3.2a2.9 2.9 0 1 0 2 2.7V3Z'
                }
              />
            )}
          </svg>
          <span translate="no">{channel.label}</span>
        </a>
      ))}
    </nav>
    <a
      class="site-header__contact"
      href={contact.whatsapp.href}
      aria-label="Hablemos por WhatsApp"
      rel="noopener noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.3-4.3A8 8 0 1 1 20 11.5Z" />
        <path d="M8.5 8.4c.3 3.5 2 5.2 5.5 5.7l1-1.4-2-1.1-.9.7a5.6 5.6 0 0 1-2.3-2.4l.7-.8-1-2-1 1.3Z" />
      </svg>
      Hablemos
    </a>
  </Container>
</header>
