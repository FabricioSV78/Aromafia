<dialog
  class="brand-intro"
  data-brand-intro
  aria-label="Presentación de AROMAFIA"
  aria-describedby="intro-description"
>
  <p class="sr-only" id="intro-description">
    Animación del logo de AROMAFIA. Al finalizar se abrirá el catálogo.
  </p>
  <template data-intro-template>
    <iframe
      class="brand-intro__frame"
      data-intro-frame
      data-src="/intro/v3/scene.html"
      title="Animación del logo de AROMAFIA"
      sandbox="allow-same-origin"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
  </template>
  <button class="brand-intro__skip" type="button" data-intro-skip autofocus>
    Saltar intro <span aria-hidden="true">↗</span>
  </button>
</dialog>

<style>
  @layer components {
    .brand-intro {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      overflow: clip;
      border: 0;
      background: #f0e8d5;
      color: #392b1b;
      opacity: 1;
      transition: opacity 350ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .brand-intro[data-intro-phase='leaving'] {
      opacity: 0;
    }
    .brand-intro:not([open]) {
      display: none;
    }
    .brand-intro::backdrop {
      background: transparent;
    }
    .brand-intro__frame {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      opacity: 0;
      pointer-events: none;
    }
    .brand-intro[data-intro-ready] .brand-intro__frame {
      opacity: 1;
    }
    .brand-intro__skip {
      position: absolute;
      right: max(1.25rem, env(safe-area-inset-right));
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      display: flex;
      gap: 1.1rem;
      align-items: center;
      min-height: 44px;
      padding: 0.65rem 1.1rem;
      border: 1px solid #77613b;
      border-radius: 2px;
      background: #f0e8d5eb;
      color: #392b1b;
      font: inherit;
      font-size: 0.875rem;
      cursor: pointer;
    }
    .brand-intro__skip:hover {
      background: #e8d8b9;
    }
    .brand-intro__skip:focus-visible {
      outline: 2px solid #6d4a12;
      outline-offset: 4px;
    }
    @media (max-width: 30rem) {
      .brand-intro__skip {
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(1rem, env(safe-area-inset-bottom));
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .brand-intro {
        transition: none;
      }
    }
  }
</style>
