---
import PageHead from '../components/seo/PageHead.astro';
import '../design/global.css';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
  noindex?: boolean;
}
const { title, description, themeColor = '#f0e8d5', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <PageHead title={title} description={description} themeColor={themeColor} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
