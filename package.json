{
  "name": "aromafia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "typecheck": "node scripts/astro.mjs check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep @a11y",
    "test:browser:install": "playwright install chromium --no-shell",
    "build": "node scripts/astro.mjs build",
    "build:pages": "npm run check:assets && npm run build && npm run check:budget && npm run check:pages",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check:assets": "node scripts/check-original-assets.mjs",
    "check:budget": "node scripts/check-build-budget.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "verify": "npm run check:assets && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:budget && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.5",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
